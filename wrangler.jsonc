{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ambersight",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-09",

  // The dashboard UI is built by Vite into ./dist and served as static assets.
  // Only /api/* reaches the Worker, so page views cost almost nothing.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // History, findings, settings and sessions. Created automatically on first deploy.
  "d1_databases": [
    { "binding": "DB", "database_name": "ambersight", "migrations_dir": "migrations" }
  ],

  // One Cron Trigger. The Free plan allows 5 per account; Ambersight uses 1.
  // It fires every 15 minutes; runs inside the scan interval set in Settings (default 1 hour)
  // stop after one D1 read, so changing the interval needs no redeploy.
  "triggers": { "crons": ["*/15 * * * *"] },

  // Ambersight's own previews must never be public.
  "workers_dev": true,
  "preview_urls": false,

  // Ambersight does not need its own logs; keep them off so it costs nothing.
  "observability": { "enabled": false },

  "vars": {
    // "free" or "paid". Free enables the 100,000 requests/day budget guard.
    "PLAN": "free",
    // Sender for alerts and the weekly digest, on a domain with Email Routing enabled.
    "EMAIL_FROM": "",
    // Verified recipient(s), comma-separated. Must match send_email below.
    "DIGEST_TO": "",
    // Optional: pin the accounts to watch (comma-separated IDs). Empty: choose them in the setup wizard.
    "CF_ACCOUNT_ID": "",
    // Optional: Cloudflare Turnstile on the sign-in page. Put the site key here and the secret in
    // the TURNSTILE_SECRET secret (npx wrangler secret put TURNSTILE_SECRET). Free.
    "TURNSTILE_SITE_KEY": ""
    // Optional: the Packages check reads package-lock.json from GitHub with a fine-grained token
    // (Contents: Read only): npx wrangler secret put GITHUB_TOKEN. Then turn it on in Settings.
  }

  // ---- Optional bindings. Each is free and off until you uncomment it. -------------------------

  // Scan queue (Queues, free plan: 10,000 operations a day). Every due account is scanned on time,
  // each in its own run with its own subrequest budget, and large fleets finish in one go.
  // Create the queue once first: npx wrangler queues create ambersight-scans
  // "queues": {
  //   "producers": [{ "binding": "SCAN_QUEUE", "queue": "ambersight-scans" }],
  //   "consumers": [{ "queue": "ambersight-scans", "max_batch_size": 1, "max_concurrency": 1, "max_retries": 0 }]
  // },

  // Workers AI, for a plain-language summary at the top of the digest (turn it on in
  // Settings › Digest). Free allocation: 10,000 neurons a day; one digest uses a few hundred.
  // "ai": { "binding": "AI" },

  // Webhook alerts (optional): `npx wrangler secret put WEBHOOK_URL` with a Slack, Discord,
  // Telegram (…/sendMessage?chat_id=…), ntfy or generic JSON endpoint URL.

  // E-mail digest (optional). Uncomment and put your verified address here:
  // "send_email": [
  //   { "name": "EMAIL", "allowed_destination_addresses": ["you@example.com"] }
  // ]
}
