{
  "name": "ambersight",
  "version": "0.1.0",
  "private": true,
  "description": "See your whole Cloudflare Workers fleet on one page. Read-only. Free. No code changes.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "dev": "npm run build && wrangler dev",
    "build": "vite build",
    "deploy": "npm run build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "typecheck": "tsc -p tsconfig.json --noEmit && svelte-check --tsconfig ./web/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.13.17"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.20.5",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "vite": "^8.1.7",
    "vitest": "^5.1.0",
    "wrangler": "^4.159.0"
  }
}
